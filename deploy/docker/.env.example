# Copy to .env (or `export` in your shell). docker compose reads .env automatically.
#
#   cp .env.example .env
#   # generate a strong key:
#   echo "VECTORDB_API_KEY=$(openssl rand -hex 32)" >> .env

# ---- Required ----------------------------------------------------------------

# API key the gateway enforces on every request. The admin backend forwards
# this transparently, so end users never see it; it lives only on the box.
VECTORDB_API_KEY=change-me-to-a-32-byte-hex-string

# ---- Optional ----------------------------------------------------------------

# Host port the admin panel publishes on. The gateway and the data node are
# never published — they're internal to the docker network.
ADMIN_PORT=8090

# Embedding server the admin panel uses by default (LMStudio compatible).
# Defaults to LMStudio on the docker host (host.docker.internal:1234). Set
# to your own embedding endpoint for production.
# EMBED_DEFAULT_URL=https://your-embedding-server/v1
# EMBED_DEFAULT_MODEL=text-embedding-nomic-embed-text-v1.5

# ---- Caddy overlay only (HTTPS) ---------------------------------------------
# Set both to enable TLS via Let's Encrypt. DNS for PUBLIC_HOSTNAME must
# already point to this server's IP before bringing Caddy up.
# PUBLIC_HOSTNAME=db.example.com
# ACME_EMAIL=you@example.com
