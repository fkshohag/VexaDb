{
  "info": {
    "name": "VexaDb Gateway",
    "_postman_id": "c8ad13e0-9b3a-4b9e-9b0a-vexadbgw0001",
    "description": "REST surface exposed by `vectordb-gateway`. Mirrors the Milvus v2.6 SDK API surface (Collections, Databases, Partitions, Indexes, Resource Groups, Vector ops, RBAC, Admin).\n\nQuick start:\n1. Import this collection together with `VexaDb-Local.postman_environment.json`.\n2. Start the gateway (`./scripts/run-single.sh` or your usual launch script). The default URL is `http://127.0.0.1:8080`.\n3. If RBAC is enabled, run **Auth / Login** first; the script stashes `apiToken` for every subsequent request.\n\nAll path variables use Postman's `:name` syntax so you can edit them per-request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{apiToken}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8080", "type": "string" },
    { "key": "apiToken", "value": "", "type": "string" },
    { "key": "dbName", "value": "default", "type": "string" },
    { "key": "collectionName", "value": "docs", "type": "string" },
    { "key": "partitionName", "value": "hot", "type": "string" },
    { "key": "fieldName", "value": "color", "type": "string" },
    { "key": "pointId", "value": "doc-001", "type": "string" },
    { "key": "aliasName", "value": "docs_v1", "type": "string" },
    { "key": "roleName", "value": "read_write", "type": "string" },
    { "key": "userName", "value": "alice", "type": "string" },
    { "key": "privilegeGroup", "value": "vector_read", "type": "string" },
    { "key": "resourceGroup", "value": "hot_rg", "type": "string" },
    { "key": "snapshotId", "value": "", "type": "string" },
    { "key": "compactionId", "value": "", "type": "string" },
    { "key": "tokenId", "value": "", "type": "string" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Always tag requests with the current Postman database so the",
          "// gateway prefixes collection names automatically.",
          "if (pm.collectionVariables.get('dbName')) {",
          "  pm.request.headers.upsert({ key: 'X-Database', value: pm.collectionVariables.get('dbName') });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Probes & Version",
      "item": [
        { "name": "GET /health", "request": { "method": "GET", "url": "{{baseUrl}}/health", "auth": { "type": "noauth" } } },
        { "name": "GET /live", "request": { "method": "GET", "url": "{{baseUrl}}/live", "auth": { "type": "noauth" } } },
        { "name": "GET /ready", "request": { "method": "GET", "url": "{{baseUrl}}/ready", "auth": { "type": "noauth" } } },
        { "name": "GET /metrics", "request": { "method": "GET", "url": "{{baseUrl}}/metrics", "auth": { "type": "noauth" } } },
        { "name": "GET /v1/version", "request": { "method": "GET", "url": "{{baseUrl}}/v1/version" } }
      ]
    },
    {
      "name": "Auth & RBAC",
      "item": [
        {
          "name": "POST /v1/auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.token) pm.collectionVariables.set('apiToken', body.token);",
                  "  if (body.token_id) pm.collectionVariables.set('tokenId', body.token_id);",
                  "  console.log('apiToken stored');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"root\",\n  \"password\": \"VexaDb!\"\n}" },
            "url": "{{baseUrl}}/v1/auth/login"
          }
        },
        {
          "name": "POST /v1/auth/tokens",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"description\": \"postman-test\"\n}" },
            "url": "{{baseUrl}}/v1/auth/tokens"
          }
        },
        {
          "name": "DELETE /v1/auth/tokens/:id",
          "request": {
