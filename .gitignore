# VectorDB runtime data
# =============================================================================
/data
/snapshots
/wal
**/snapshots/
**/wal/
# Storage + logs produced by scripts/run-single.sh (raw-binary single-instance).
/run-data/

# Cluster shape (user-local). docker-compose.yml + config/cluster/*.toml
# are regenerated from this by scripts/cluster.py.
.cluster.state.json

